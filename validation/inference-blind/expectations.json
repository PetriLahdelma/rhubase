      "abstention": { "forbidBasis": ["documentation-explicit"], "reason": "equal token values without directional documentation cannot establish a rename" },
      "coverage": { "fromTokens": ["brand.primary", "surface.base"], "toTokens": ["content.inverse", "canvas.default"] }
    },
    {
